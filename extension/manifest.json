{
	"manifest_version": 3,
	"name": "Open in Review",
	"version": "1.0.0",
	"description": "Press Shift+R on a GitHub pull request to open its review in the Review desktop app.",
	"homepage_url": "https://review-code.dev/",
	"icons": {
		"16": "icons/16.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"permissions": ["storage"],
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": false
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "open-in-review@review-code.dev",
			"strict_min_version": "109.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}
