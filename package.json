{
	"name": "review",
	"productName": "Review",
	"version": "0.1.0",
	"private": true,
	"description": "Local desktop code review for Git branches",
	"main": "./out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"dist": "electron-vite build && electron-builder --mac",
		"dist:mac": "electron-vite build && electron-builder --mac",
		"dist:win": "electron-vite build && electron-builder --win",
		"dist:linux": "electron-vite build && electron-builder --linux",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "node --test --test-concurrency=1 test/*.test.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "node scripts/sign-electron.mjs"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "0.129.0",
		"@google/genai": "2.24.0",
		"@modelcontextprotocol/sdk": "1.32.0",
		"openai": "7.25.0",
		"semver": "7.8.5",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/node": "22.20.4",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/semver": "7.8.0",
		"@vitejs/plugin-react": "5.2.0",
		"@yogesharc/thinking-orbs": "0.1.1",
		"electron": "44.5.0",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"prettier": "3.9.9",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"typescript": "5.9.3",
		"vite": "7.3.6"
	},
	"author": "Hamed Ghaderi",
	"license": "MIT"
}
